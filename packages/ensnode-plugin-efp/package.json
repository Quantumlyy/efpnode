  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": ">=0.36.0 <0.50.0",
    "viem": "^2.50.3"
  },
  "peerDependencies": {
    "ponder": ">=0.16.0 <0.18.0"
  },
  "peerDependenciesMeta": {
    "ponder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
